@model List<string>
@{
    ViewData["Title"] = "Order/Inventory Queue";
}
<div class="container py-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Order/Inventory Queue Messages (Azure Queue Storage)</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Queue" asp-action="Send" method="post" class="d-flex mb-3">
                <input class="form-control me-2" type="text" name="message" placeholder="e.g. Order #1234 - Processing" required />
                <button class="btn btn-primary" type="submit">Send Message</button>
            </form>

            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No messages in the queue.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var msg in Model)
                    {
                        <li class="list-group-item">@msg</li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
