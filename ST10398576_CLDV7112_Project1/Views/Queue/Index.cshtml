@model List<string>
@{
    ViewData["Title"] = "Order/Inventory Queue";
}

<h1>Order/Inventory Queue Messages (Azure Queue Storage)</h1>

<form asp-controller="Queue" asp-action="Send" method="post">
    <input type="text" name="message" placeholder="e.g. Processing order #1234" style="width:300px" required />
    <button type="submit">Send Message</button>
</form>

<ul>
    @foreach (var msg in Model)
    {
        <li>@msg</li>
    }
</ul>
