@model List<string>
@{
    ViewData["Title"] = "Product Images";
}

<div class="container py-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Product Images (Azure Blob Storage)</h5>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-controller="Image" asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-3 d-flex gap-2 align-items-center">
                <input class="form-control" type="file" name="imageFile" accept="image/*" required />
                <button class="btn btn-primary" type="submit">Upload Image</button>
            </form>

            <div class="row row-cols-2 row-cols-md-3 g-3">
                @foreach (var url in Model)
                {
                    var uri = new Uri(url);
                    var blobName = uri.Segments.Last();
                    <div class="col">
                        <div class="card h-100">
                            <img src="@url" class="card-img-top" alt="Product image" style="object-fit:cover; height:150px;" />
                            <div class="card-body d-flex flex-column">
                                <div class="mt-auto d-flex justify-content-between">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Image" asp-action="Download" asp-route-blobName="@blobName">Download</a>
                                    <a class="btn btn-sm btn-link" target="_blank" href="@url">Open</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <p class="text-muted mt-3">No images found.</p>
            }
        </div>
    </div>
</div>
